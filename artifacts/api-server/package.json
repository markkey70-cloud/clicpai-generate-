{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:refund": "esbuild tests/video-refunds.test.ts --bundle --platform=node --format=cjs --external:pg-native --external:@replit/connectors-sdk --outfile=dist/video-refunds.test.cjs && node --test dist/video-refunds.test.cjs",
    "test:billing": "esbuild tests/billing-confirmation.test.ts --bundle --platform=node --format=cjs --external:pg-native --external:@replit/connectors-sdk --outfile=dist/billing-confirmation.test.cjs && node --test dist/billing-confirmation.test.cjs",
    "test:voice": "esbuild tests/voice-presets.test.ts --bundle --platform=node --format=cjs --external:pg-native --external:@replit/connectors-sdk --outfile=dist/voice-presets.test.cjs && node --test dist/voice-presets.test.cjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.69",
    "@clerk/shared": "^4.33.0",
    "@replit/connectors-sdk": "^0.4.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
